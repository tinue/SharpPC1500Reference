# Test 2: both modules program areas; small ML areas (one bank)
# Program-area test 2 -- see README.md for what to do after it loads.
# PC-1600, no plotter, two CE-1600M. Nothing is loaded here: programs go in
# by hand with (B)LOAD"COM1:" + sde.

model: PC-1600

memory-expansion-1:
  - modulespec: CE-1600M
memory-expansion-2:
  - modulespec: CE-1600M

keys:
  - key: mode          # -> PRO
  - type: NEW0
  - key: mode          # -> RUN
# Retype both CE-1600Ms as program modules (MEM drops to 11834)
  - type: INIT"S1:","P"
  - type: INIT"S2:","P"
# ML areas of &1000 (3899 bytes) in all three areas -- NEW needs PRO mode
  - key: mode          # -> PRO
  - type: NEW"S0:",&1000
  - type: NEW"S1:",&1000
  - type: NEW"S2:",&1000
  - key: mode          # -> RUN
  - type: TITLE"S0:"
# COM1: 9600 8N1, no handshake (Calc-U-1600 User Guide ch. 7)
  - type: SETCOM "COM1:",9600,8,N,1,N,N
  - type: OUTSTAT "COM1:"
  - type: SNDSTAT "COM1:",28
  - type: RCVSTAT "COM1:",28
  - type: INIT "COM1:",4096
  - key: shift
  - key: cl
  - type: PRINT"T2 small ML  MEM=";MEM

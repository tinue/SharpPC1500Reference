# Test 1: both modules merged into S0; one big BASIC program
# Program-area test 1 -- see README.md for what to do after it loads.
# PC-1600, no plotter, two CE-1600M. Nothing is loaded here: programs go in
# by hand with (B)LOAD"COM1:" + sde.

model: PC-1600

memory-expansion-1:
  - modulespec: CE-1600M
memory-expansion-2:
  - modulespec: CE-1600M

keys:
  - key: mode          # -> PRO
  - type: NEW0
  - key: mode          # -> RUN
# COM1: 9600 8N1, no handshake (Calc-U-1600 User Guide ch. 7)
  - type: SETCOM "COM1:",9600,8,N,1,N,N
  - type: OUTSTAT "COM1:"
  - type: SNDSTAT "COM1:",28
  - type: RCVSTAT "COM1:",28
  - type: INIT "COM1:",4096
  - key: shift
  - key: cl
  - type: PRINT"T1 merged  MEM=";MEM
